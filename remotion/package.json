{
  "name": "animated-spoon-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Remotion video workspace",
  "scripts": {
    "studio": "remotion studio src/index.jsx",
    "render": "remotion render src/index.jsx BottleScanOnly out/bottle-film.mp4 --codec=h264",
    "render-diamonds": "remotion render src/index.jsx DiamondsPolish out/diamonds-polished.mov --codec=h264",
    "render-water": "remotion render src/index.jsx WaterHidesDiamonds out/water-hides-diamonds.mp4 --codec=h264",
    "render-smartphone": "remotion render src/index.jsx SmartphoneNotification out/smartphone-notification.mp4 --codec=h264",
    "render-reel": "remotion render src/index.jsx ImperialLuxeReel out/imperial-luxe-reel-video-only.mp4 --codec=h264",
    "render-first-scene-test": "remotion render src/index.jsx FirstSceneVideoTest out/first-scene-lightning-remotion-4.0.544-test.mp4 --codec=h264",
    "render-third-scene-cat-music-test": "remotion render src/index.jsx ThirdSceneCatMusicTest out/third-scene-cat-music-remotion-test.mp4 --codec=h264"
  },
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "remotion": "4.0.544",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
